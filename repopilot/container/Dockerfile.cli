# RepoPilot's unprivileged, read-only CLI distribution.
#
# This image can index mounted Python source and render offline evidence.
# It deliberately contains NO Docker client/daemon, GITHUB_TOKEN, or model keys.
# Do NOT mount /var/run/docker.sock: repair verification belongs on a
# separately provisioned, disposable Docker-capable operator worker.
FROM python:3.12.8-slim-bookworm AS builder
WORKDIR /src
COPY pyproject.toml ./
COPY src/ ./src/
RUN python -m pip wheel --no-deps --wheel-dir /wheels .

FROM python:3.12.8-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
COPY --from=builder /wheels /tmp/wheels
RUN python -m pip install --no-index --no-deps --find-links=/tmp/wheels \
        'repopilot==2.3.0' \
    && rm -rf /tmp/wheels \
    && mkdir -p /workspace \
    && chmod 0755 /workspace
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["python", "-m", "repopilot.cli"]
CMD ["--help"]
