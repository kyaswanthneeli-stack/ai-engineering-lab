# RepoPilot operator configuration. Copy to your own ignored env file.
# DO NOT commit a real token. Do not use this file with Docker --env-file
# when running read-only indexing or dashboard operations.
REPOPILOT_MODEL=qwen2.5-coder:3b
REPOPILOT_BASE_URL=http://127.0.0.1:11434/v1
REPOPILOT_OLLAMA_NATIVE=1
REPOPILOT_PROVIDER_TIMEOUT_SECONDS=110
REPOPILOT_AGENT_BUDGET_SECONDS=270
REPOPILOT_MAX_TOKENS=1200
REPOPILOT_FINAL_CONTEXT_CHARS=9000
# Optional, benchmark-only candidate smoke validation, requires safe Docker.
REPOPILOT_CANDIDATE_SMOKE=0
# Opt-in minimal import setup for historical SymPy/Django and src/lib layouts.
# This is a weak smoke runtime, not the official evaluator environment.
REPOPILOT_CANDIDATE_SMOKE_BOOTSTRAP=0
# Optional bounded behavior checks, frozen from original source docstrings.
REPOPILOT_CANDIDATE_SOURCE_EXAMPLES=0
# Optional digest-pinned official native runtime; only the supported Matplotlib
# base commit is accepted. Prepare the exact image through the CI workflow.
REPOPILOT_CANDIDATE_MATPLOTLIB_NATIVE=0
# Benchmark repair heuristic: reject quote-only edits and request correction.
# Set to 0 only for intentional source-formatting/reflection tasks.
REPOPILOT_REJECT_QUOTE_ONLY=1
# Only for human-approved draft PR publishing on a trusted operator host.
# Never place a real value here or in a committed file:
# GITHUB_TOKEN=
# OpenAI-compatible external providers require HTTPS and their own credential.
# REPOPILOT_API_KEY=
