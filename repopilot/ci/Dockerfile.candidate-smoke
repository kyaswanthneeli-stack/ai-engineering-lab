# Trusted, optional offline runtime for candidate smoke checks.
#
# This image is built only from developer-maintained, version-pinned wheels.
# It NEVER installs requirements/setup.py/pyproject.toml from untrusted target
# repositories. Runtime uses Docker --network=none and --pull=never.
# Original source checkout remains an immutable read-only mount.
#
# Best-effort Python-3.10 compatibility for historical benchmark checkouts.
# These are *not* the official SWE-bench evaluator environments or proof of a
# passing original baseline; results must be measured on each task.
FROM python:3.10-slim-bookworm
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN python -m pip install --only-binary=:all: --no-cache-dir \
      mpmath==1.3.0 \
      asgiref==3.7.2 \
      sqlparse==0.4.4 \
      pytz==2023.3.post1 \
      python-dateutil==2.9.0.post0 \
      tzdata==2023.3 \
      packaging==24.2 \
      numpy==1.23.5 \
      scipy==1.10.1 \
      pandas==1.5.3 \
      Pillow==9.5.0 \
      cycler==0.12.1 \
      kiwisolver==1.4.5 \
      pyparsing==3.1.1 \
      fonttools==4.44.3 \
      contourpy==1.1.1 \
      joblib==1.3.2 \
      threadpoolctl==3.2.0
